{
  "name": "logarys-ingestor",
  "version": "0.2.2",
  "private": true,
  "description": "NestJS HTTP log ingestion service publishing normalized logs to NATS JetStream.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --watch --loader ts-node/esm src/main.ts",
    "lint": "tsc -p tsconfig.build.json --noEmit",
    "test": "./scripts/test-no-warnings.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:node": "node --test",
    "test:container": "RUN_TESTS_IN_CONTAINER=1 ./scripts/test-no-warnings.sh"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "11.1.*",
    "@nestjs/config": "4.0.*",
    "@nestjs/core": "11.1.*",
    "@nestjs/platform-express": "11.1.*",
    "axios": "^1.15.2",
    "class-transformer": "0.5.*",
    "class-validator": "0.14.*",
    "nats": "2.29.*",
    "reflect-metadata": "0.2.*",
    "rxjs": "7.8.*",
    "small-log-normalizer": "0.1.*",
    "@logarys/pipeline-validator": "^0.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.*",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "prettier": "^3.8.3",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
